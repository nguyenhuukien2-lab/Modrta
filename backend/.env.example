# ─── DATABASE (Supabase) ─────────────────────────────────────────────────────
# Pooler URL - dùng cho runtime (API requests)
DATABASE_URL="postgresql://postgres.[PROJECT_ID]:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct URL - chỉ dùng cho prisma migrate
DIRECT_URL="postgresql://postgres.[PROJECT_ID]:[PASSWORD]@aws-0-ap-southeast-1.supabase.co:5432/postgres"

# ─── SECURITY ────────────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="your-random-32-byte-hex-string-here"
BCRYPT_ROUNDS="10"

# ─── SERVER ──────────────────────────────────────────────────────────────────
PORT="4000"
NODE_ENV="development"

# ─── CORS ────────────────────────────────────────────────────────────────────
# Frontend URL (Next.js dev server)
FRONTEND_URL="http://localhost:3000"
