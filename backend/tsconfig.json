{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": false,
    "noImplicitAny": false,
    "suppressImplicitAnyIndexErrors": true,
    "noImplicitThis": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": false,
    "resolveJsonModule": true,
    "declaration": false,
    "sourceMap": false,
    "noEmitOnError": false,
    "allowJs": true,
    "checkJs": false,
    "suppressErrorsExternally": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "prisma"],
  "ts-node": {
    "transpileOnly": true,
    "files": true
  }
}
